      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/companies/:ticker/documents",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "companies",
            ":ticker",
            "documents"
          ],
          "query": []
