{
  "info": {
    "name": "Nifty 100 Analytics API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ],
          "query": []
        },
        "description": "status, per-table row counts, uptime, version"
      }
    },
    {
      "name": "List companies",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/companies",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "companies"
          ],
          "query": [
            {
              "key": "sector",
              "value": ""
            },
            {
              "key": "market_cap_category",
              "value": ""
            },
            {
              "key": "search",
              "value": ""
            }
          ]
        },
        "description": "All 92 companies (id, name, sector, ROE, ROCE), optionally filtered"
      }
    },
    {
      "name": "Get company profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/companies/:ticker",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "companies",
            ":ticker"
          ],
          "query": []
        },
        "description": "Full company profile + latest-year KPIs. 404 if unknown."
      }
    },
