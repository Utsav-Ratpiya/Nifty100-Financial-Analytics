      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/sectors",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "sectors"
          ],
          "query": []
        },
        "description": "All broad sectors with company_count, median_roe, median_pe, median_de"
