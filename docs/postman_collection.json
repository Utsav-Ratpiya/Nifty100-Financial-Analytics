          "path": [
            "api",
            "v1",
            "companies",
            ":ticker",
            "bs"
          ],
          "query": [
            {
              "key": "from_year",
              "value": ""
            },
            {
              "key": "to_year",
              "value": ""
            }
          ]
        },
        "description": "Balance sheet history, optional year range filter"
