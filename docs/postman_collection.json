      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/companies/:ticker/pl",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "companies",
            ":ticker",
            "pl"
          ],
          "query": [
            {
              "key": "from_year",
              "value": ""
            },
            {
              "key": "to_year",
              "value": ""
            }
          ]
        },
        "description": "P&L history, optional YYYY-MM year range filter"
      }
    },
    {
      "name": "Get balance sheet history",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
