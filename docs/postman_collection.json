      "name": "Run the screener",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/screener",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "screener"
